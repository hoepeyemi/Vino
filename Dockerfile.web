FROM node:20-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@10

WORKDIR /repo

# Install deps (layer-cached until lockfile changes)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/package.json ./app/package.json
COPY agent/package.json ./agent/package.json
COPY contracts/package.json ./contracts/package.json

RUN pnpm install --frozen-lockfile --filter vino-app...

COPY . .

WORKDIR /repo/app

# ── Build-time env vars ───────────────────────────────────────────────────────
# Network & RPC — public endpoints, baked in directly.
ENV NEXT_PUBLIC_NETWORK_MODE=testnet
ENV NEXT_PUBLIC_CHAIN_ID=10143
ENV NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Contract addresses — from contracts/deployments/monadTestnet.json (deployed 2026-07-30)
ENV NEXT_PUBLIC_INVOICE_NFT_ADDRESS=0x827f01e7c3111cbB7b690E12B365eC0E14b144f6
ENV NEXT_PUBLIC_YIELD_VAULT_ADDRESS=0xd4DE5d9DC3fFd4c728dE13aaE57C74628cd441b5
ENV NEXT_PUBLIC_AGENT_ROUTER_ADDRESS=0x410494FC48f1cC24904fC3cc57F608ba498b12EA
ENV NEXT_PUBLIC_PRIVACY_REGISTRY_ADDRESS=0x6872DC335eDF9A1525b005c38820641AdF78d9A1

# Server-specific vars use placeholders — docker-entrypoint.sh replaces them
# at container startup from .env.app so no secrets are needed in CI.
ENV NEXT_PUBLIC_AGENT_WS_URL=__VINO_AGENT_WS_URL__
ENV NEXT_PUBLIC_APP_URL=__VINO_APP_URL__
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=__VINO_WC_PROJECT_ID__

RUN pnpm build

# ── Production image ──────────────────────────────────────────────────────────
FROM node:20-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /srv

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN groupadd --system nodejs && useradd --system --gid nodejs nextjs

# Copy the full standalone tree — server.js lives at standalone/app/server.js
# and references ../node_modules (standalone/node_modules) at runtime.
COPY --from=base --chown=nextjs:nodejs /repo/app/.next/standalone/        ./standalone/
# Static client assets must sit inside the app subdirectory
COPY --from=base --chown=nextjs:nodejs /repo/app/.next/static/            ./standalone/app/.next/static/
COPY --from=base --chown=nextjs:nodejs /repo/app/public/                  ./standalone/app/public/
COPY --from=base --chown=nextjs:nodejs /repo/app/docker-entrypoint.sh     ./docker-entrypoint.sh

RUN chmod +x ./docker-entrypoint.sh

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health >/dev/null 2>&1 || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
