# vino app environment variables
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV:  copy to .env.local and fill in values
# PRODUCTION: copy to ~/vino/.env.app on the Ubuntu server and fill in values
#             The Docker container reads this file at startup and injects every
#             NEXT_PUBLIC_* value into the pre-built JS bundle automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Blockchain ────────────────────────────────────────────────────────────────
# Chain ID: 10143 = Monad Testnet | 31337 = Local Anvil
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_NETWORK_MODE=testnet

# Monad Testnet RPC (optional override — public endpoint is used by default)
NEXT_PUBLIC_MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# ── Contract addresses ────────────────────────────────────────────────────────
# Set these after running: npm run deploy:monad --prefix contracts
# Values from contracts/deployments/monadTestnet.json
NEXT_PUBLIC_INVOICE_NFT_ADDRESS=0x827f01e7c3111cbB7b690E12B365eC0E14b144f6
NEXT_PUBLIC_YIELD_VAULT_ADDRESS=0xd4DE5d9DC3fFd4c728dE13aaE57C74628cd441b5
NEXT_PUBLIC_AGENT_ROUTER_ADDRESS=0x410494FC48f1cC24904fC3cc57F608ba498b12EA
NEXT_PUBLIC_PRIVACY_REGISTRY_ADDRESS=0x6872DC335eDF9A1525b005c38820641AdF78d9A1
NEXT_PUBLIC_MOCK_ORACLE_ADDRESS=0x70231d59379687CaBab203b99481baC7300a19ca

# Block number just before your first deployment (used to limit log range)
NEXT_PUBLIC_DEPLOY_BLOCK=0

# ── Agent WebSocket ───────────────────────────────────────────────────────────
# Production: use your server's public IP or domain
# e.g.  ws://123.45.67.89:8080   or   wss://agent.yourdomain.com
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8080

# ── App URL ───────────────────────────────────────────────────────────────────
# Production: your server's public IP or domain
# e.g.  http://123.45.67.89:3000   or   https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Get a project ID at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Cleanverse KYB ───────────────────────────────────────────────────────────
# Required for real business verification. Obtain from Cleanverse International.
# When not set, the app silently skips the KYB gate (sandbox / demo mode).
#   Sandbox API: https://uatapi.cleanverse.com/api/cooperate
#   Production:  https://api.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate

# RELAY_PRIVATE_KEY — deployer wallet private key (same as contracts/.env PRIVATE_KEY).
#   Must be the MockCVI Ownable owner so the self-service onboard route can call verify().
#   Never commit this value. Pass via --env-file at container startup.
RELAY_PRIVATE_KEY=
# MOCK_CVI_ADDRESS — server-side override for the deployed MockCVI address.
# NEXT_PUBLIC_MOCK_CVI_ADDRESS — same address exposed to the client for live isVerified() reads.
# Both default to the Monad Testnet deployment below if not set.
MOCK_CVI_ADDRESS=0x98DbA1d179b013342C2f63Ef551Cf72de4bb64e3
NEXT_PUBLIC_MOCK_CVI_ADDRESS=0x98DbA1d179b013342C2f63Ef551Cf72de4bb64e3

# ── QuickBooks OAuth (optional) ───────────────────────────────────────────────
# Only needed if you use the QuickBooks invoice import feature
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI is no longer needed — it is derived automatically
# from the request origin at runtime. Register these two URIs in the Intuit
# Developer Portal (Keys & OAuth → Redirect URIs):
#   http://localhost:3000/api/quickbooks/callback       (local dev)
#   http://<your-server-ip>:3000/api/quickbooks/callback  (production)
QUICKBOOKS_ENVIRONMENT=sandbox
