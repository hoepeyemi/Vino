# Private key for deployment (with MON for gas — get from Monad testnet faucet)
# For LOCAL development with Anvil, use the default account #0:
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For TESTNET/MAINNET, use your own funded wallet key:
PRIVATE_KEY=your_private_key_here

# RPC URL
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Optional: API key for contract verification (if Monad explorer supports it)
ETHERSCAN_API_KEY=

# ── Cleanverse KYB ───────────────────────────────────────────────────────────
# Required for generate-apass.js and relay-kyb-approval.js
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate
