# ─────────────────────────────────────────────────────────────────────────────
# vino — MemoriVault agent runtime env  (lives at ~/vino/.env.agent on server)
# DO NOT COMMIT.  Copy this file and fill in every blank value.
# The Docker container reads it with --env-file at startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC ───────────────────────────────────────────────────────────────────────
# Monad Testnet public endpoint — override with a private RPC if you have one.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# ── Agent wallet ──────────────────────────────────────────────────────────────
# 32-byte hex private key (0x + 64 hex chars).
# This wallet signs on-chain transactions (rebalancing, settlement).
# Give it enough MON for gas.  Omit to run in read-only (no-tx) mode.
AGENT_PRIVATE_KEY=

# ── AI — Qwen Cloud ──────────────────────────────────────────────────────────
# Get a key at https://dashscope-intl.aliyuncs.com or the hackathon LiteLLM proxy.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Optional model overrides:
# QWEN_MAX_MODEL=qwen-max
# QWEN_TURBO_MODEL=qwen-turbo

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_PORT=8080
# WS_AUTH_TOKEN=    # uncomment to require token auth on WS connections

# ── Contract addresses (Monad Testnet — Chain ID 10143) ───────────────────────
# From contracts/deployments/monadTestnet.json  (already bundled in image).
# Override here only if you redeploy to different addresses.
INVOICE_NFT_ADDRESS=0x827f01e7c3111cbB7b690E12B365eC0E14b144f6
YIELD_VAULT_ADDRESS=0xd4DE5d9DC3fFd4c728dE13aaE57C74628cd441b5
AGENT_ROUTER_ADDRESS=0x410494FC48f1cC24904fC3cc57F608ba498b12EA
MOCK_ORACLE_ADDRESS=0x70231d59379687CaBab203b99481baC7300a19ca

# ── Cleanverse KYB (optional but recommended) ────────────────────────────────
# When set, the agent makes real Cleanverse A-Pass checks for KYB-gated actions.
# Use the same credentials as the app.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_API_URL=https://uatapi.cleanverse.com/api/cooperate

# ── Memory backends (optional upgrades) ──────────────────────────────────────
# L1: default is in-process Map — upgrade to Redis for multi-instance
# REDIS_URL=redis://localhost:6379

# L2: default is JSON file at /app/agent/data/l2-episodic.json — upgrade to pgvector
# DATABASE_URL=postgresql://user:pass@host:5432/memorivault
